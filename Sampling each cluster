import numpy as np
import pandas as pd


# --------------------------------------------------
# 1. Calculate sample size (global)
# --------------------------------------------------
def calculate_sample_size(confidence=0.95, margin_of_error=0.05):
    """
    Calculate required sample size using standard formula
    """
    from scipy.stats import norm

    p = 0.5
    z = norm.ppf((1 + confidence) / 2)

    n = (z**2 * p * (1 - p)) / (margin_of_error**2)
    return int(np.ceil(n))


# --------------------------------------------------
# 2. Cluster-based sampling
# --------------------------------------------------
def cluster_sampling(df, cluster_col, n_per_cluster):
    """
    Sample equal number of users from each cluster
    """
    samples = []

    for cluster in df[cluster_col].unique():
        cluster_data = df[df[cluster_col] == cluster]

        n = min(n_per_cluster, len(cluster_data))  # avoid errors

        sample = cluster_data.sample(n=n, random_state=42)
        samples.append(sample)

    return pd.concat(samples)


# --------------------------------------------------
# 3. Random sampling (baseline)
# --------------------------------------------------
def random_sampling(df, total_n):
    """
    Simple random sampling
    """
    return df.sample(n=total_n, random_state=42)


# --------------------------------------------------
# 4. Evaluate sampling quality
# --------------------------------------------------
def evaluate_sampling(population, sample, features):
    """
    Compare sample vs population using mean difference
    """
    results = []

    for feature in features:
        pop_mean = population[feature].mean()
        sample_mean = sample[feature].mean()

        bias = abs(sample_mean - pop_mean)

        results.append({
            "feature": feature,
            "population_mean": pop_mean,
            "sample_mean": sample_mean,
            "absolute_bias": bias
        })

    return pd.DataFrame(results)


# --------------------------------------------------
# 5. Compare two sampling methods
# --------------------------------------------------
def compare_sampling_methods(df, cluster_col, features):
    """
    Compare cluster-based vs random sampling
    """

    # Sample size
    n_total = calculate_sample_size()

    n_clusters = df[cluster_col].nunique()
    n_per_cluster = int(np.ceil(n_total / n_clusters))

    # Sampling
    cluster_sample = cluster_sampling(df, cluster_col, n_per_cluster)
    random_sample = random_sampling(df, len(cluster_sample))

    # Evaluation
    cluster_eval = evaluate_sampling(df, cluster_sample, features)
    random_eval = evaluate_sampling(df, random_sample, features)

    # Add labels
    cluster_eval["method"] = "cluster_sampling"
    random_eval["method"] = "random_sampling"

    return pd.concat([cluster_eval, random_eval])


# --------------------------------------------------
# 6. Example usage
# --------------------------------------------------
if __name__ == "__main__":

    # Example: assume df already has cluster column
    df = pd.read_csv("clustered_data.csv")

    features = [
        'car', 'bike', 'box',
        'van', 'van-floor', 'van-roof',
        'truck', 'intercity'
    ]

    results = compare_sampling_methods(df, "cluster", features)

    print("\nSampling Comparison Results:")
    print(results)

    # Aggregate comparison
    summary = results.groupby("method")["absolute_bias"].mean()

    print("\nAverage Bias by Method:")
    print(summary)

    improvement = (
        (summary["random_sampling"] - summary["cluster_sampling"])
        / summary["random_sampling"]
    ) * 100

    print(f"\nBias Reduction with Cluster Sampling: {improvement:.2f}%")
